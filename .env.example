# Settings reads environment variables; this file is a guide, not auto-loaded.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-generated-locally
DJANGO_ALLOWED_HOSTS=your-host.example
DJANGO_HTTPS=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-host.example
# Enable only if the trusted proxy overwrites client forwarded headers.
DJANGO_TRUST_PROXY_SSL=0
GUNICORN_BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
# APP_REVISION is set by tools/start_server.sh.
# Optional database location:
# DJANGO_DB_PATH=/absolute/path/to/database.sqlite3
# DJANGO_STATIC_ROOT=/absolute/path/to/collected-static
